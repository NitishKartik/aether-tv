<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#4D00E5FF"
                android:centerColor="#331A2634"
                android:endColor="#4D00E5FF"
                android:angle="45" />
            <stroke
                android:width="2dp"
                android:color="#FF00E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#26101726" />
            <stroke
                android:width="1dp"
                android:color="#2AFFFFFF" />
        </shape>
    </item>
</selector>
