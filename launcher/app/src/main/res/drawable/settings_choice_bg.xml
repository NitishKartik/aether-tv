<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused & Selected -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#8000E5FF"
                android:endColor="#807C4DFF"
                android:angle="0" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- Focused only -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#6600E5FF"
                android:endColor="#667C4DFF"
                android:angle="0" />
            <stroke android:width="2.5dp" android:color="#FF00E5FF" />
        </shape>
    </item>

    <!-- Selected only -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#4D00E5FF"
                android:endColor="#4D7C4DFF"
                android:angle="0" />
            <stroke android:width="2dp" android:color="#FF00E5FF" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#261A2634" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
