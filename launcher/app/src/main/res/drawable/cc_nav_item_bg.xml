<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on D-pad navigation -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF0F6FC" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- Currently selected category tab (unfocused) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3300E5FF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FF00E5FF" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A263445" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</selector>
