<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5080C16"
    android:paddingStart="56dp"
    android:paddingEnd="56dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AETHER TV // SYSTEM CONFIGURATION"
                    android:textColor="#FF00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/launcher_settings"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp"
                    android:fontFamily="@font/outfit_bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSettingsBack"
                style="@style/SettingsRow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/glass_pill_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="BACK TO EXIT"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:fontFamily="@font/outfit_medium"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Scrollable Settings Sections -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SECTION 1: Privacy & Security Card -->
                <LinearLayout
                    android:id="@+id/privacySecurityChoice"
                    style="@style/SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/glass_card_bg"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:text="🛡️"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Privacy &amp; Security"
                                android:textColor="#FFFFFFFF"
                                android:textSize="18sp"
                                android:fontFamily="@font/outfit_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="macOS lock screen, PIN setup, auto-lock timeout, smart media guard"
                                android:textColor="#80FFFFFF"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_regular" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPrivacyLockBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/glass_pill_bg"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="PROTECTED"
                            android:textColor="#FF00E676"
                            android:textSize="11sp"
                            android:fontFamily="@font/outfit_bold" />

                        <TextView
                            android:id="@+id/txtPrivacyTimeoutBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/glass_pill_bg"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="15 MIN"
                            android:textColor="#FF00E5FF"
                            android:textSize="11sp"
                            android:fontFamily="@font/outfit_bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 2: D-Pad & Remote Customization Card -->
                <LinearLayout
                    android:id="@+id/dpadCustomizationChoice"
                    style="@style/SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/glass_card_bg"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:text="🎮"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="D-Pad &amp; Remote Customization"
                                android:textColor="#FFFFFFFF"
                                android:textSize="18sp"
                                android:fontFamily="@font/outfit_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Customize double-clicks, triple-clicks, long-press hold duration and actions"
                                android:textColor="#80FFFFFF"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_regular" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtDpadStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/glass_pill_bg"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="CUSTOMIZE ➔"
                            android:textColor="#FF00E5FF"
                            android:textSize="11sp"
                            android:fontFamily="@font/outfit_bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 3: Screensaver & Display Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/glass_card_bg"
                    android:padding="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCREENSAVER &amp; DISPLAY"
                        android:textColor="#FF00E5FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.08" />

                    <!-- Screensaver Timeout Row -->
                    <LinearLayout
                        android:id="@+id/screensaverChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Start Screensaver After Inactivity"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit_medium" />

                        <TextView
                            android:id="@+id/txtScreensaverTimeout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 MINUTES"
                            android:textColor="#FF00E676"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit_bold" />
                    </LinearLayout>

                    <!-- Wallpaper Row -->
                    <TextView
                        android:id="@+id/wallpaperChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true" />

                    <!-- Animations Row -->
                    <TextView
                        android:id="@+id/animationsChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true" />

                    <!-- Advanced Effects Row -->
                    <TextView
                        android:id="@+id/advancedChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true" />
                </LinearLayout>

                <!-- SECTION 4: App Grid & Dock Layout Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/glass_card_bg"
                    android:padding="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APP GRID &amp; DOCK LAYOUT"
                        android:textColor="#FF00E5FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.08" />

                    <!-- Columns -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/columns_label"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="4" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="5" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="6" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="7" android:fontFamily="@font/outfit_bold" />
                    </LinearLayout>

                    <!-- Rows Below Dock -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/rows_below_dock_label"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="0" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="1" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="2" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="3" android:fontFamily="@font/outfit_bold" />
                    </LinearLayout>

                    <!-- Dock Opacity -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/dock_opacity_label"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="100%" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="70%" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="50%" android:fontFamily="@font/outfit_bold" />
                        <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:background="@drawable/glass_pill_bg" android:text="30%" android:fontFamily="@font/outfit_bold" />
                    </LinearLayout>

                    <!-- Reorder Apps -->
                    <TextView
                        android:id="@+id/reorderChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:text="@string/reorder"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true" />

                    <!-- Open On Start -->
                    <TextView
                        android:id="@+id/openOnStartChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true"
                        android:visibility="gone" />

                    <!-- Follow Theme / Reset -->
                    <TextView
                        android:id="@+id/followThemeChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:text="@string/follow_theme"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true" />
                </LinearLayout>

                <!-- SECTION 5: TV System & Defaults Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_card_bg"
                    android:padding="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEM SETTINGS"
                        android:textColor="#FF00E5FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.08" />

                    <!-- TV System Settings -->
                    <TextView
                        android:id="@+id/tvSettingsChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:text="@string/tv_settings"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true" />

                    <!-- Default Home Launcher -->
                    <TextView
                        android:id="@+id/defaultHomeChoice"
                        style="@style/SettingsRow"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_pill_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_settings"
                        android:fontFamily="@font/outfit_medium"
                        android:textSize="15sp"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
