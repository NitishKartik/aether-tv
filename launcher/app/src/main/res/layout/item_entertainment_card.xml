<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/glass_card_bg"
    android:orientation="vertical"
    android:padding="16dp"
    android:focusable="true"
    android:clickable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/movieTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/ratingPill"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:text="Interstellar"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/ratingPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/glass_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="★ 8.7"
            android:textColor="#FFFFD700"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/movieMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2014 · 2h 49m · Sci-Fi"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_regular" />

        <TextView
            android:id="@+id/watchlistBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♥ SAVED"
            android:textColor="#FFFF4081"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/moviePlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival."
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_light" />
</LinearLayout>
