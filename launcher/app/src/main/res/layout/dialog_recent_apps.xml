<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9080B10">

    <LinearLayout
        android:id="@+id/dialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="22dp"
        android:elevation="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recentsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT APPS"
                    android:textColor="#00FF66"
                    android:textSize="18sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/recentsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Running background tasks • MacBook switcher"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- Clean All Button -->
            <TextView
                android:id="@+id/btnCleanAll"
                style="@style/TopButton"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/clean_all_apps"
                android:textColor="#00FF66"
                android:drawableStart="@drawable/ic_swap_vert"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:clickable="true" />
        </RelativeLayout>

        <!-- Recents Horizontal Carousel with 3D Tilt -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentsList"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Empty State (if no recent apps) -->
        <TextView
            android:id="@+id/emptyRecents"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="center"
            android:text="@string/no_recent_apps"
            android:textColor="#8CFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit"
            android:visibility="gone" />

        <!-- Footer / Keyboard hint -->
        <TextView
            android:id="@+id/recentsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="[OK] Switch to app   •   [Down] Close app   •   [Back] Return to Home"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>
</FrameLayout>
