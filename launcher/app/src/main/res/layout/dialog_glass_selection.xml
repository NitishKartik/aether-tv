<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glassDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9050B14"
    android:focusable="true">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/settings_section_card_bg"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Eyebrow -->
        <TextView
            android:id="@+id/dialogEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AETHER TV // CONFIGURATION"
            android:textColor="#FF00E5FF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_bold"
            android:letterSpacing="0.1" />

        <!-- Title -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select Option"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/outfit_bold" />

        <TextView
            android:id="@+id/dialogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose your preferred setting using TV remote D-Pad"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_regular" />

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#20FFFFFF" />

        <!-- Scrollable Options Container -->
        <ScrollView
            android:id="@+id/dialogScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:maxHeight="360dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="#20FFFFFF" />

        <!-- Bottom Actions Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnNeutralAction"
                style="@style/SettingsRow"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/glass_pill_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Default"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:fontFamily="@font/outfit_medium"
                android:visibility="gone"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnCancelAction"
                style="@style/SettingsRow"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/glass_pill_bg"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Cancel"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="@font/outfit_medium"
                android:focusable="true" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
