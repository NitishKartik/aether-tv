<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pinSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9050B14"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/glass_card_bg"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AETHER TV // SECURITY"
            android:textColor="#FF00E5FF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/pinSetupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Set 4-Digit Security PIN"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/outfit_bold" />

        <TextView
            android:id="@+id/pinSetupStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter 4 digits using the keypad below"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_regular" />

        <!-- 4 Masked PIN Dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/pinDot0" android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="8dp" android:text="○" android:textColor="#80FFFFFF" android:gravity="center" android:textSize="20sp" />
            <TextView android:id="@+id/pinDot1" android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="8dp" android:text="○" android:textColor="#80FFFFFF" android:gravity="center" android:textSize="20sp" />
            <TextView android:id="@+id/pinDot2" android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="8dp" android:text="○" android:textColor="#80FFFFFF" android:gravity="center" android:textSize="20sp" />
            <TextView android:id="@+id/pinDot3" android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="8dp" android:text="○" android:textColor="#80FFFFFF" android:gravity="center" android:textSize="20sp" />
        </LinearLayout>

        <!-- Numeric Keypad Grid -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnPin1" style="@style/PinKey" android:text="1" />
                <Button android:id="@+id/btnPin2" style="@style/PinKey" android:text="2" />
                <Button android:id="@+id/btnPin3" style="@style/PinKey" android:text="3" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnPin4" style="@style/PinKey" android:text="4" />
                <Button android:id="@+id/btnPin5" style="@style/PinKey" android:text="5" />
                <Button android:id="@+id/btnPin6" style="@style/PinKey" android:text="6" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnPin7" style="@style/PinKey" android:text="7" />
                <Button android:id="@+id/btnPin8" style="@style/PinKey" android:text="8" />
                <Button android:id="@+id/btnPin9" style="@style/PinKey" android:text="9" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnPinClear" style="@style/PinKey" android:text="⌫" android:textColor="#FFFF5252" />
                <Button android:id="@+id/btnPin0" style="@style/PinKey" android:text="0" />
                <Button android:id="@+id/btnPinSave" style="@style/PinKey" android:text="✓" android:textColor="#FF00E676" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnPinCancel"
            style="@style/SettingsRow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Cancel"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="@font/outfit_medium" />
    </LinearLayout>
</FrameLayout>
