<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2070C16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <!-- Top Header & Tabs -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/cinemaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cinema &amp; Discovery"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="@font/outfit_light"
                android:letterSpacing="-0.01" />

            <Button
                android:id="@+id/btnCloseCinema"
                style="@style/TopButton"
                android:layout_alignParentEnd="true"
                android:text="Close" />
        </RelativeLayout>

        <!-- Category Tabs Row -->
        <LinearLayout
            android:id="@+id/categoryTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button android:id="@+id/tabAll" style="@style/TopButton" android:text="All Trending" android:textColor="#FF00E5FF" />
            <Button android:id="@+id/tabMovies" style="@style/TopButton" android:text="Movies" />
            <Button android:id="@+id/tabTv" style="@style/TopButton" android:text="TV Series" />
            <Button android:id="@+id/tabHindi" style="@style/TopButton" android:text="Hindi Cinema" />
            <Button android:id="@+id/tabTopImdb" style="@style/TopButton" android:text="Top Rated (8.5+)" />
            <Button android:id="@+id/tabWatchlist" style="@style/TopButton" android:text="Watchlist" />
        </LinearLayout>

        <!-- Grid of Cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cinemaRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/cinemaHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Press OK to view details &amp; save to Watchlist · Powered by IMDb Metadata · 100% Offline Ready"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_regular" />
    </LinearLayout>
</FrameLayout>
