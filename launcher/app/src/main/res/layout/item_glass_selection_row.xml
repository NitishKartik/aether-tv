<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selectionRowRoot"
    style="@style/SettingsRow"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/glass_pill_bg"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/rowIcon"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:text="🔘"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:text="Option Title"
        android:textColor="@color/settings_choice_text"
        android:textSize="16sp"
        android:fontFamily="@font/outfit_medium"
        android:singleLine="true" />

    <TextView
        android:id="@+id/rowCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textColor="#FF00E676"
        android:textSize="18sp"
        android:fontFamily="@font/outfit_bold"
        android:visibility="gone" />
</LinearLayout>
