<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6050B14">

    <!-- Atmospheric radial glow -->
    <ImageView
        android:id="@+id/lockBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_aurora_horizon"
        android:alpha="0.35" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Top Header: macOS Style Clock & Date -->
        <TextClock
            android:id="@+id/lockClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <TextClock
            android:id="@+id/lockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.05" />

        <!-- macOS Center Glass Auth Card (Ergonomic 2-Column TV Layout) -->
        <LinearLayout
            android:id="@+id/lockCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/glass_card_bg"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Left Column: User Profile & PIN Display -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- User Avatar Circle -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_pill_bg">

                    <TextView
                        android:id="@+id/userInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="N"
                        android:textColor="#FF00E5FF"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit_medium" />
                </FrameLayout>

                <TextView
                    android:id="@+id/lockUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="NITISH"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.05" />

                <!-- PIN masked dots display -->
                <TextView
                    android:id="@+id/lockPinDisplay"
                    android:layout_width="190dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:background="@drawable/glass_pill_bg"
                    android:hint="Enter PIN"
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FF00E5FF"
                    android:textSize="18sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.25" />

                <TextView
                    android:id="@+id/lockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Use TV remote to enter PIN"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <!-- Vertical subtle divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="160dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#26FFFFFF" />

            <!-- Right Column: TV Remote D-pad On-Screen Numeric Keypad -->
            <GridLayout
                android:id="@+id/keypadGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4">

                <!-- Row 1 -->
                <Button android:id="@+id/btnKey1" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="1" />
                <Button android:id="@+id/btnKey2" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="2" />
                <Button android:id="@+id/btnKey3" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="3" />

                <!-- Row 2 -->
                <Button android:id="@+id/btnKey4" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="4" />
                <Button android:id="@+id/btnKey5" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="5" />
                <Button android:id="@+id/btnKey6" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="6" />

                <!-- Row 3 -->
                <Button android:id="@+id/btnKey7" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="7" />
                <Button android:id="@+id/btnKey8" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="8" />
                <Button android:id="@+id/btnKey9" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="9" />

                <!-- Row 4 -->
                <Button android:id="@+id/btnKeyClear" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="⌫" android:textColor="#FFFF5252" />
                <Button android:id="@+id/btnKey0" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="0" />
                <Button android:id="@+id/btnKeyUnlock" style="@style/TopButton" android:layout_width="48dp" android:layout_height="36dp" android:layout_margin="2dp" android:padding="0dp" android:text="➔" android:textColor="#FF00E5FF" />
            </GridLayout>
        </LinearLayout>

        <!-- Lock Screen Now Playing Media Card -->
        <LinearLayout
            android:id="@+id/lockNowPlayingCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/glass_pill_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_now_playing" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/lockNowPlayingTitle"
                    android:layout_width="wrap_content"
                    android:maxWidth="280dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Now Playing"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:id="@+id/lockNowPlayingArtist"
                    android:layout_width="wrap_content"
                    android:maxWidth="280dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Background Playback"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
