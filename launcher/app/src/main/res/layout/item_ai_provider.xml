<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/providerCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/glass_card_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/providerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenAI"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/providerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/glass_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ONLINE"
            android:textColor="#FF00E676"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium" />
    </RelativeLayout>

    <TextView
        android:id="@+id/providerModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="GPT-4o / o1 · October 2026"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/outfit_regular" />

    <!-- Progress Bar for Token Consumption -->
    <ProgressBar
        android:id="@+id/tokenProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:progress="34"
        android:max="100"
        android:progressTint="#FF00E5FF"
        android:progressBackgroundTint="#33FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tokensText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="342K / 1M tokens (34%)"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_regular" />

        <TextView
            android:id="@+id/spentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$6.84 / $50.00"
            android:textColor="#FF00E5FF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rateLimitText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="10,000 TPM · Tier 3"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_light" />

        <TextView
            android:id="@+id/requestsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1,284 requests"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_light" />
    </LinearLayout>
</LinearLayout>
