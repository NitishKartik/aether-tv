<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2060B14">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/dnsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ AdGuard Private DNS Protection"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="@font/outfit_light"
                    android:letterSpacing="-0.01" />

                <Button
                    android:id="@+id/btnCloseDns"
                    style="@style/TopButton"
                    android:layout_alignParentEnd="true"
                    android:text="Close" />
            </RelativeLayout>

            <!-- Main Hostname Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFICIAL PRIVATE DNS HOSTNAME"
                    android:textColor="#FF00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/txtDnsHostname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_pill_bg"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="dns.adguard.com"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.08" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCopyDns"
                        style="@style/TopButton"
                        android:text="📋 Copy Hostname"
                        android:textColor="#FF00E5FF" />

                    <Button
                        android:id="@+id/btnOpenNetworkSettings"
                        style="@style/TopButton"
                        android:text="⚙️ Open Private DNS Settings"
                        android:textColor="#FF00E676" />

                    <Button
                        android:id="@+id/btnTestDns"
                        style="@style/TopButton"
                        android:text="🔍 Run DNS Verification Test" />
                </LinearLayout>

                <!-- Status Feedback -->
                <TextView
                    android:id="@+id/txtDnsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Press 'Run DNS Verification Test' to verify current filtering status"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <!-- Guide and Capabilities -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Steps -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/glass_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIGURATION STEPS (ANDROID 9+)"
                        android:textColor="#FF00E5FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="1. Click 'Open Private DNS Settings' above.\n2. In Android Settings, navigate to Network &amp; Internet -> Private DNS.\n3. Select 'Private DNS provider hostname'.\n4. Paste or type 'dns.adguard.com'.\n5. Save and restart apps."
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular" />
                </LinearLayout>

                <!-- What it blocks vs cannot block -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAPABILITIES &amp; HONEST LIMITS"
                        android:textColor="#FFFFD700"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="✓ Blocks ad networks, tracking scripts, spyware, and popups.\n✓ Zero CPU/battery impact; encrypted via DNS-over-TLS (DoT).\n✗ Cannot block video ads served from the same content domain (e.g., YouTube in-stream video ads)."
                        android:textColor="#D9FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
