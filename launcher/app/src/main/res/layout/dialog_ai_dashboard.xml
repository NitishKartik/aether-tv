<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2080D1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <!-- Top Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dashboardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Usage &amp; Limits Dashboard"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp"
                    android:fontFamily="@font/outfit_light"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/lastSyncText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Last Synced: Just now · Offline Cache Ready"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSync"
                    style="@style/TopButton"
                    android:text="Sync Metrics"
                    android:textColor="#FF00E5FF" />

                <Button
                    android:id="@+id/btnCloseDashboard"
                    style="@style/TopButton"
                    android:text="Close" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Providers Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/providersRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- Footer Notice -->
        <TextView
            android:id="@+id/footerNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Press OK on any provider card to configure API Key · Fully functional offline with persistent cache"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_regular" />
    </LinearLayout>
</FrameLayout>
