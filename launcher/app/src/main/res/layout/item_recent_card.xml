<?xml version="1.0" encoding="utf-8"?>
<!-- iPhone-style App Switcher Card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="168dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Card Top Header (iOS style: small app icon + title) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:minHeight="30dp">

        <TextView
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:gravity="center_vertical"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/status_dot" />
    </LinearLayout>

    <!-- Main iOS App Window Preview Canvas (Focusable: Press OK to switch, UP to flick close) -->
    <FrameLayout
        android:id="@+id/cardBody"
        android:layout_width="152dp"
        android:layout_height="180dp"
        android:background="@drawable/glass_panel"
        android:focusable="true"
        android:clickable="true"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/previewLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/appTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="Active"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.08" />
    </FrameLayout>

    <!-- Close Button (Also triggered by pressing D-pad UP on the card) -->
    <TextView
        android:id="@+id/btnCloseApp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:text="@string/clean_app"
        android:textColor="#FF6666"
        android:textSize="11sp"
        android:fontFamily="@font/outfit_medium"
        android:background="@drawable/pill_bg"
        android:focusable="true"
        android:clickable="true" />
</LinearLayout>
